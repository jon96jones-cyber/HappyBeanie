{% comment %}
  Happy Beanie — complete your order (invoice / pay-by-link).
  Paste into: Shopify admin → Settings → Notifications → Customer notifications
  → Draft order invoice → Edit code (replace the whole HTML body). The same
  body works for the "Order invoice" notification.
  Suggested subject line:  Your Happy Beanie order is ready — one step left
  {{ invoice_url }} is Shopify's secure payment link for the order.
{% endcomment %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Complete your Happy Beanie order</title></head>
<body style="margin:0; padding:0; background:#e7decb;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#e7decb; font-size:1px; line-height:1px;">Your order {{ name }} is prepared — complete payment and we start blending.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#e7decb;"><tr><td align="center" style="padding:28px 12px;">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background:#fcfaf4; border:1px solid #e0d6c2; border-radius:10px; overflow:hidden;">

      <tr><td style="background:#17140f; padding:22px 30px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        <td align="left"><img src="https://www.happybeanie.com/assets/email-logo-2.png" width="133" height="38" alt="happy beanie" style="display:block; border:0; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:20px; font-weight:700; letter-spacing:-0.5px; color:#f5f0e6;"></td>
        <td align="right" style="font-family:'DM Mono',Menlo,Consolas,monospace; font-size:9px; letter-spacing:2px; text-transform:uppercase; color:#8a7f6e;">Order&nbsp;desk</td>
      </tr></table></td></tr>
      <tr><td style="height:3px; background:#f2ce59; font-size:0; line-height:0;">&nbsp;</td></tr>

      <tr><td style="padding:38px 34px 6px;">
        <p style="margin:0 0 14px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8a7f6e;">— &nbsp;Order {{ name }} · ready to complete</p>
        <h1 style="margin:0 0 14px; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:27px; line-height:1.1; letter-spacing:-1px; font-weight:700; color:#17140f;">{% assign first_name = billing_address.first_name | default: customer.first_name %}{% if first_name %}One step left, {{ first_name }}.{% else %}One step left.{% endif %}</h1>
        <p style="margin:0 0 26px; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:15.5px; line-height:1.62; color:#554c40;">Your order is prepared — everything below is set and priced. Complete payment through the secure link and we start blending your batch.</p>

        <!-- Order card -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f0e6; border:1px solid #e0d6c2; border-radius:10px;"><tr><td style="padding:8px 20px;">
          {% for line in line_items %}
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:1px solid #e0d6c2;"><tr>
            {% if line.image %}<td width="66" style="padding:14px 14px 14px 0;"><img src="{{ line.image | img_url: 'small' }}" width="52" height="52" alt="" style="display:block; border:0; border-radius:6px; background:#e7decb;"></td>{% endif %}
            <td style="padding:14px 0; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.45; color:#17140f;"><b>{{ line.title }}</b><br><span style="font-family:'DM Mono',Menlo,Consolas,monospace; font-size:10px; letter-spacing:1px; text-transform:uppercase; color:#8a7f6e;">Qty {{ line.quantity }}</span></td>
            <td align="right" style="padding:14px 0; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:13px; color:#17140f; white-space:nowrap;">{{ line.final_line_price | money }}</td>
          </tr></table>
          {% endfor %}
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-bottom:1px solid #e0d6c2;"><tr>
            <td style="padding:14px 0 10px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:#8a7f6e;">Subtotal</td>
            <td align="right" style="padding:14px 0 10px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:13px; color:#17140f;">{{ subtotal_price | money }}</td>
          </tr></table>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
            <td style="padding:12px 0 14px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:#8a7f6e;">Total</td>
            <td align="right" style="padding:12px 0 14px; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:16px; font-weight:700; color:#17140f;">{{ total_price | money }}</td>
          </tr></table>
        </td></tr></table>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 8px;"><tr><td align="center" bgcolor="#f2ce59" style="border-radius:999px;">
          <a href="{{ invoice_url }}" style="display:block; padding:17px 24px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:12px; letter-spacing:2px; text-transform:uppercase; font-weight:700; color:#17140f; text-decoration:none;">Complete your order →</a>
        </td></tr></table>
        <p style="margin:10px 0 0; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:9.5px; letter-spacing:1px; text-transform:uppercase; color:#8a7f6e;" align="center">Secure Shopify checkout · card details never touch our inbox</p>

        <!-- What happens next -->
        <p style="margin:28px 0 12px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8a7f6e;">— &nbsp;What happens next</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td style="padding:0 0 12px;">
            <span style="display:inline-block; width:22px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:11px; color:#325e3f; vertical-align:top;">01</span><span style="display:inline-block; width:520px; max-width:88%; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.6; color:#554c40; vertical-align:top;"><b style="color:#17140f;">You pay through the link</b> — it opens a secure Shopify checkout with this exact order. Nothing to re-enter, nothing changes.</span>
          </td></tr>
          <tr><td style="padding:0 0 12px;">
            <span style="display:inline-block; width:22px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:11px; color:#325e3f; vertical-align:top;">02</span><span style="display:inline-block; width:520px; max-width:88%; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.6; color:#554c40; vertical-align:top;"><b style="color:#17140f;">We blend your batch</b> — made to order in Scottsdale, AZ, and the lot's third-party certificate is published before it ships.</span>
          </td></tr>
          <tr><td style="padding:0 0 6px;">
            <span style="display:inline-block; width:22px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:11px; color:#325e3f; vertical-align:top;">03</span><span style="display:inline-block; width:520px; max-width:88%; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.6; color:#554c40; vertical-align:top;"><b style="color:#17140f;">Tracking lands in your inbox</b> — the moment your box leaves the bench, you'll know.</span>
          </td></tr>
        </table>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:26px 0 30px; background:#f5f0e6; border:1px solid #e0d6c2; border-radius:8px;"><tr><td style="padding:18px 20px;">
          <p style="margin:0; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:14.5px; line-height:1.6; color:#554c40;">Anything look off — quantities, pricing, address? Reply to this email before paying and we'll fix the order first. A person reads this inbox, not a queue.</p>
        </td></tr></table>
      </td></tr>

      <tr><td style="background:#f5f0e6; border-top:1px solid #e0d6c2; padding:26px 34px 30px;" align="center">
        <p style="margin:0 0 12px; font-family:'DM Mono',Menlo,Consolas,monospace; font-size:9px; letter-spacing:2px; text-transform:uppercase; color:#8a7f6e;">Formulated fresh · Scottsdale, AZ</p>
        <p style="margin:0; font-family:'DM Sans',Helvetica,Arial,sans-serif; font-size:11px; line-height:1.6; color:#8a7f6e;">You're getting this because an order was prepared for you at happybeanie.com.<br>Questions? <a href="mailto:hello@happybeanie.com" style="color:#325e3f; text-decoration:none;">hello@happybeanie.com</a> &nbsp;·&nbsp; © 2026 Happy Beanie</p>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>
