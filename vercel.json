{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "happybeanie.com" }],
      "destination": "https://www.happybeanie.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "happybeany.com" }],
      "destination": "https://www.happybeanie.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.happybeany.com" }],
      "destination": "https://www.happybeanie.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|policies|api/|admin|wholesale|account|favicon).*)",
      "destination": "/"
    }
  ]
}
